{
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "es2022",
        "outDir": "out",
        "lib": [
            "es2022"
        ],
        "sourceMap": true,
        "rootDir": ".",
        "noUnusedLocals": true,
        "noImplicitThis": true,
        "noImplicitReturns": true,
        "strict": false,
        "strictNullChecks": true,
        "noUnusedParameters": true,
        "types": [
            "node",
            "mocha"
        ],
        "paths": {
            "*": [
                "./node_modules/@types/*",
                "./*"
            ]
        },
        "skipLibCheck": false
    },
    "exclude": [
        "node_modules",
        ".vscode-test",
    ]
}
